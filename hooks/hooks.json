{
  "description": "요청 기준 주입, 압축 복구, 코드 컨벤션 재로딩과 변경 턴의 결과 보류 완료 대조를 위한 훅",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/inonego_guard.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'hooks/run_guard.ps1')\"",
            "timeout": 5,
            "statusMessage": "작업 기준을 복구하는 중",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/inonego_guard.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'hooks/run_guard.ps1')\"",
            "timeout": 5,
            "statusMessage": "요청 기준을 복구하는 중",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/inonego_guard.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'hooks/run_guard.ps1')\"",
            "timeout": 5,
            "statusMessage": "코드 편집 기준을 확인하는 중",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/inonego_guard.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'hooks/run_guard.ps1')\"",
            "timeout": 5,
            "statusMessage": "변경 턴의 완료 대조를 준비하는 중",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/inonego_guard.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'hooks/run_guard.ps1')\"",
            "timeout": 5,
            "statusMessage": "변경 결과의 완료 대조를 시작하는 중"
          }
        ]
      }
    ]
  }
}
