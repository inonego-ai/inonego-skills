{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/session_start_compact_skill_policy.ps1')\"",
            "statusMessage": "Applying compact skill policy"
          }
        ]
      }
    ]
  }
}
